ANTHROPIC_API_KEY=sk-ant-...
# Only needed for user-level keys (sk-ant-usr-...)
ANTHROPIC_WORKSPACE_ID=
MODEL=claude-sonnet-5-5
# Fast model for each voice turn (chat, supersede check, onboarding)
CHAT_MODEL=claude-haiku-5-5
ELEVENLABS_API_KEY=sk_...
VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Memory: "surreal" (default) or "local" (memory.json)
MEMORY_BACKEND=surreal
SPECTRON_URL=https://<your-context-host>
SPECTRON_CONTEXT_ID=<your-context-id>
SPECTRON_API_KEY=sp-...
MEMORY_SCOPE=app/handsfree-chef/user/default
# Observability (Arize AX)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
JUDGE_MODEL=claude-haiku-5-5
